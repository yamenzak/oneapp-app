msgstr "إسناد {0} سجل"

msgid "Assign {0} records"
msgstr "إسناد {0} سجلات"

msgid "Assigned to"
msgstr "مُسنَد إلى"

msgid "Assignments, mentions and alerts turn up here."
msgstr "تظهر هنا الإسنادات والإشارات والتنبيهات."

msgid "Assignments, mentions and workspace notices, in the app."
msgstr "الإسنادات والإشارات وإشعارات مساحة العمل، داخل التطبيق."

msgid "Assistant"
msgstr "المساعد"

msgid "Assistant Avatar"
msgstr "صورة المساعد"


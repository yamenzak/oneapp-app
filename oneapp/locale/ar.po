# Arabic translation for oneapp.
#
# The msgid is the English sentence, so this file holds only what nobody
# upstream has translated already — see scripts/i18n.py.
msgid ""
msgstr ""
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ar\n"

msgid "0 follows the screen."
msgstr "0 يتبع الشاشة."

msgid "1 thing"
msgstr "عنصر واحد"

msgid "1 thing chosen"
msgstr "عنصر واحد محدد"

msgid "1 thing, more below"
msgstr "عنصر واحد، والمزيد أدناه"

msgid ""
"<p>The warning goes to whoever is <b>following</b> this document, once — "
"not every morning until somebody acts, which is how people learn to "
"ignore it.</p>"
msgstr ""
"<p>يصل التنبيه إلى كل من <b>يتابع</b> هذا المستند، مرة واحدة — لا كل "
"صباح حتى يتحرك أحد، فهكذا يتعلم الناس تجاهله.</p>"

msgid "A CSS length — 40mm, 120px, 50%. Empty fits the column."
msgstr "طول CSS — 40mm، 120px، 50%. اتركه فارغًا ليلائم العمود."

msgid "A Select becomes its own options; a Link becomes whoever is on the page."
msgstr "حقل الاختيار يصبح خياراته، وحقل الربط يصبح من على الصفحة."

msgid "A camera needs a secure connection. Use the phone's camera instead."
msgstr "الكاميرا تحتاج اتصالاً آمناً. استخدم كاميرا الهاتف بدلاً من ذلك."

msgid "A colon after every label"
msgstr "نقطتان بعد كل تسمية"

msgid "A comment needs something in it."
msgstr "التعليق يحتاج إلى محتوى."

msgid "A counter cannot go below zero."
msgstr "لا يمكن أن ينزل العداد تحت الصفر."

msgid "A counter is a whole number."
msgstr "العداد رقم صحيح."

msgid "A disabled letter head cannot be the default one."
msgstr "لا يمكن أن تكون ترويسة معطّلة هي الافتراضية."

msgid "A document cannot renew itself."
msgstr "لا يمكن للمستند أن يجدّد نفسه."

msgid "A document whose expiry date is coming up."
msgstr "مستند يقترب تاريخ انتهائه."

msgid ""
"A file path or URL. Referenced from the header above, or used on its "
"own."
msgstr "مسار ملف أو رابط. يُشار إليه من الرأس أعلاه، أو يُستخدم بمفرده."

msgid "A filter on {0} may only narrow {0}."
msgstr "المرشّح على {0} لا يمكنه إلا تضييق {0}."

msgid "A folder cannot be attached to a record."
msgstr "لا يمكن إرفاق مجلد بسجل."

msgid "A folder cannot be moved inside itself."
msgstr "لا يمكن نقل مجلد داخل نفسه."

msgid ""
"A folder cannot be shared as a link — it would include whatever is put "
"in it later."
msgstr "لا يمكن مشاركة مجلد كرابط — سيشمل كل ما يوضع فيه لاحقًا."

msgid "A folder name cannot contain a slash."
msgstr "لا يمكن أن يحتوي اسم المجلد على شرطة مائلة."

msgid "A folder needs a name."
msgstr "المجلد يحتاج إلى اسم."

msgid "A format called {0} already exists."
msgstr "يوجد بالفعل نموذج باسم {0}."

msgid "A format is drawn over the records an app in this workspace shows."
msgstr "يُرسم النموذج فوق السجلات التي يعرضها تطبيق في مساحة العمل هذه."

msgid "A format needs a name."
msgstr "النموذج يحتاج إلى اسم."

msgid ""
"A letter and a form are numbered in separate sequences, because that is "
"what somebody quoting one on the phone expects."
msgstr ""
"الخطاب والنموذج يُرقَّمان في تسلسلين منفصلين، لأن هذا ما يتوقعه من يذكر "
"رقم أحدهما على الهاتف."

msgid "A letter from its name is used where there is none."
msgstr "يستخدم حرف من اسمه عند غياب الصورة."

msgid "A letter head called {0} already exists."
msgstr "توجد بالفعل ترويسة باسم {0}."

msgid "A letter head needs a name."
msgstr "الترويسة تحتاج إلى اسم."

msgid ""
"A letter kept to start others from. Templates are not numbered against "
"the real sequence."
msgstr "خطاب محفوظ لبدء خطابات أخرى منه. القوالب لا تُرقَّم ضمن التسلسل الحقيقي."

msgid "A link can last between 1 and {0} days."
msgstr "يمكن أن يدوم الرابط بين يوم واحد و{0} يومًا."

msgid ""
"A lucide name from the offered set, or an emoji. Anything else is "
"dropped on the way in — a lucide name reaches the DOM as a class."
msgstr ""
"اسم lucide من المجموعة المعروضة، أو رمز تعبيري. أي شيء آخر يُسقَط عند "
"الإدخال — اسم lucide يصل إلى DOM كفئة."

msgid "A mailbox the team shares"
msgstr "صندوق بريد يشترك فيه الفريق"

msgid "A name cannot be empty."
msgstr "لا يمكن أن يكون الاسم فارغًا."

msgid ""
"A named version is never thinned out. The automatic ones are, once they "
"are old enough to be too many."
msgstr ""
"النسخة المسماة لا تُختصر أبداً. أما النسخ التلقائية فتُختصر متى قدُمت "
"وزاد عددها."

msgid "A new {0} file is not something this can make."
msgstr "لا يمكن لهذا إنشاء ملف {0} جديد."

msgid "A record can be shared with {0} people. Use a role beyond that."
msgstr "يمكن مشاركة السجل مع {0} أشخاص. استخدم دورًا لما بعد ذلك."

msgid "A record can carry {0} tags. Take one off first."
msgstr "يمكن أن يحمل السجل {0} وسوم. أزل واحدًا أولًا."

msgid "A record needs an id."
msgstr "السجل يحتاج إلى معرّف."

msgid "A record needs at least one series to be named by."
msgstr "السجل يحتاج إلى تسلسل واحد على الأقل ليُسمّى به."

msgid "A reply written once, ready to send again."
msgstr "رد يُكتب مرة واحدة، جاهز للإرسال مجددًا."

msgid ""
"A role of your own can reach anything your apps expose, and nothing "
"else."
msgstr "الدور الذي تنشئه بنفسك يصل إلى كل ما تتيحه تطبيقاتك، ولا شيء غير ذلك."

msgid "A source has to be https. Credentials travel to it."
msgstr "يجب أن يكون المصدر https. بيانات الاعتماد تنتقل إليه."

msgid "A source is a host and nothing else, like https://old.example.com."
msgstr "المصدر مضيف ولا شيء غيره، مثل https://old.example.com."

msgid "A source is named by hostname, not by address."
msgstr "المصدر يُسمّى باسم المضيف، لا بالعنوان."

msgid ""
"A starting structure for your country. Accounts can be added later; the "
"shape is hard to change once entries exist."
msgstr ""
"هيكل بداية لبلدك. يمكن إضافة الحسابات لاحقًا؛ ويصعب تغيير الشكل بعد وجود "
"القيود."

msgid "A tag needs a name."
msgstr "الوسم يحتاج إلى اسم."

msgid "A template called {0} already exists."
msgstr "يوجد قالب بالاسم {0} بالفعل."

msgid ""
"A template is a subject and a message somebody can send without writing "
"it again."
msgstr "القالب هو موضوع ورسالة يمكن لأحدهم إرسالهما دون كتابتهما من جديد."

msgid "A template with nothing in it is not a template."
msgstr "قالب لا شيء فيه ليس قالبًا."

msgid "A template written for a record can say {{ doc.customer }} and mean it."
msgstr "القالب المكتوب لسجل يمكن أن يذكر {{ doc.customer }} ويقصده فعلًا."

msgid "A workspace owner can turn it on under Settings, AI."
msgstr "يمكن لمالك مساحة العمل تفعيله من الإعدادات، الذكاء الاصطناعي."

msgid "A {0} has no rows called {1} to fill."
msgstr "لا يحتوي {0} على صفوف باسم {1} لتعبئتها."

msgid "AI"
msgstr "الذكاء الاصطناعي"

msgid "AI Written Value"
msgstr "قيمة كتبها الذكاء الاصطناعي"

msgid "AI credits"
msgstr "أرصدة الذكاء الاصطناعي"

msgid "API key"
msgstr "مفتاح API"

msgid "API secret"
msgstr "سر API"

msgid "Access"
msgstr "الوصول"

msgid "Add a column"
msgstr "إضافة عمود"

msgid "Add a connection"
msgstr "إضافة اتصال"

msgid "Add a file"
msgstr "إضافة ملف"

msgid "Add a mailbox"
msgstr "إضافة صندوق بريد"

msgid "Add a picture"
msgstr "إضافة صورة"

msgid "Add a section"
msgstr "إضافة قسم"

msgid "Add a tag"
msgstr "إضافة وسم"

msgid "Add an address"
msgstr "إضافة عنوان"

msgid "Add an image"
msgstr "إضافة صورة"

msgid "Add domain"
msgstr "إضافة نطاق"

msgid "Add filter"
msgstr "إضافة مرشّح"

msgid "Add one on {0} and mail to it arrives here."
msgstr "أضف واحدًا على {0} ليصل البريد الموجّه إليه هنا."

msgid "Add rule"
msgstr "إضافة قاعدة"

msgid "Add to favourites"
msgstr "إضافة إلى المفضلة"

msgid "Add {0} to favourites"
msgstr "إضافة {0} إلى المفضلة"

msgid "Add-ons"
msgstr "الإضافات"

msgid "Added to the bottom of mail sent from this address."
msgstr "يُضاف إلى أسفل البريد المرسل من هذا العنوان."

msgid ""
"Added to the instructions it already has. It changes how answers read, "
"not what a feature does."
msgstr "يضاف إلى التعليمات الموجودة. يغير أسلوب الإجابات لا وظيفة الميزة."

msgid ""
"Added to the instructions this feature already has. Use it for your "
"preferences, not for changing what the feature does."
msgstr ""
"يُضاف إلى التعليمات الموجودة لهذه الميزة. استخدمه لتفضيلاتك، لا لتغيير "
"ما تفعله الميزة."

msgid "Added — checking your DNS now"
msgstr "تمت الإضافة — يجري الآن فحص DNS"

msgid "Added — it is on your next invoice"
msgstr "تمت الإضافة — ستظهر في فاتورتك التالية"

msgid "Address created"
msgstr "تم إنشاء العنوان"

msgid "Address removed"
msgstr "تمت إزالة العنوان"

msgid ""
"After this the link is gone and the file is not. Empty is refused on "
"purpose: a link with no end is a file published for ever by somebody who "
"has left."
msgstr ""
"بعد هذا يختفي الرابط ويبقى الملف. الفراغ مرفوض عن قصد: رابط بلا نهاية هو "
"ملف نشره إلى الأبد شخص غادر."

msgid "Ai Enabled"
msgstr "الذكاء الاصطناعي مفعّل"

msgid "Alert removed"
msgstr "تمت إزالة التنبيه"

msgid "Alert saved"
msgstr "تم حفظ التنبيه"

msgid "Alerts"
msgstr "التنبيهات"

msgid "Alerts could not be loaded"
msgstr "تعذّر تحميل التنبيهات"

msgid "Alex Rivera"
msgstr "أليكس ريفيرا"

msgid "Align labels right"
msgstr "محاذاة التسميات إلى اليمين"

msgid "Align to the centre"
msgstr "محاذاة إلى الوسط"

msgid "Align to the end"
msgstr "محاذاة إلى النهاية"

msgid "Align to the start"
msgstr "محاذاة إلى البداية"

msgid "All conversations"
msgstr "كل المحادثات"

msgid "All day"
msgstr "طوال اليوم"

msgid "All files"
msgstr "كل الملفات"

msgid "All mail"
msgstr "كل البريد"

msgid "All {0}"
msgstr "كل {0}"

msgid "All {0} templates…"
msgstr "كل قوالب {0}…"

msgid "Allowed domains"
msgstr "النطاقات المسموح بها"

msgid "Also to"
msgstr "نسخة إلى"

msgid "Always on"
msgstr "مفعّل دائمًا"

msgid "Amended"
msgstr "معدّل"

msgid ""
"An add-on goes on the same invoice as your plan, so there has to be a "
"plan first."
msgstr "تُدرج الإضافة في نفس فاتورة خطتك، لذا يجب أن تكون هناك خطة أولاً."

msgid ""
"An address may use letters, numbers, dots, dashes and underscores, and "
"must start and end with a letter or number."
msgstr ""
"يمكن أن يستخدم العنوان حروفًا وأرقامًا ونقاطًا وشرطات وشرطات سفلية، ويجب "
"أن يبدأ وينتهي بحرف أو رقم."

msgid "An admin gives you one, or connect the mailbox you already have below."
msgstr "يمنحك المسؤول واحدًا، أو اربط صندوق البريد الذي لديك بالأسفل."

msgid "An alert needs a subject — it is the line people see."
msgstr "التنبيه يحتاج إلى موضوع — هو السطر الذي يراه الناس."

msgid "An alert watches one kind of record and tells somebody when it changes."
msgstr "يراقب التنبيه نوعًا واحدًا من السجلات ويُخبر شخصًا عند تغيّره."

msgid "An app password where the provider needs one."
msgstr "كلمة مرور تطبيق إن كان المزوّد يطلبها."

msgid "An earlier version"
msgstr "نسخة سابقة"

msgid ""
"An invited person gets a welcome email within a few minutes. Removing "
"someone stops them signing in; the work they created stays in the "
"workspace."
msgstr ""
"يصل الشخص المدعو بريد ترحيب خلال دقائق قليلة. إزالة شخص تمنعه من تسجيل "
"الدخول؛ أما العمل الذي أنشأه فيبقى في مساحة العمل."

msgid "An out-of-office reply needs something to say."
msgstr "رد الغياب عن المكتب يحتاج إلى نص."

msgid "And for the ones that file things somebody does."
msgstr "وللقواعد التي تُصنّف أشياء يحتاج أحدهم إلى الاطلاع عليها."

msgid "Any record"
msgstr "أي سجل"

msgid ""
"Any record that refuses the change — a submitted one, or a value a rule "
"forbids — is left alone and named."
msgstr ""
"أي سجل يرفض التغيير — سجل مُرسَل، أو قيمة تمنعها قاعدة — يُترك كما هو "
"ويُذكر اسمه."

msgid "Anybody"
msgstr "أي شخص"

msgid "Anybody who can sign in here, whatever their role reaches."
msgstr "أي شخص يمكنه تسجيل الدخول هنا، مهما كان مدى وصول دوره."

msgid "Anything it should keep in mind"
msgstr "أي شيء ينبغي أن يأخذه في الحسبان"

msgid "Anything on this site: an employee, a company, a vehicle, a project."
msgstr "أي شيء على هذا الموقع: موظف، شركة، مركبة، مشروع."

msgid "Api Key"
msgstr "مفتاح API"

msgid "Api Secret"
msgstr "سرّ API"

msgid "Appearance"
msgstr "المظهر"

msgid "Appears on account names, e.g. Debtors - ACME."
msgstr "يظهر في أسماء الحسابات، مثل المدينون - ACME."

msgid ""
"Appended to our instructions. The model receives both; this field never "
"contains ours."
msgstr ""
"يُضاف إلى تعليماتنا. يتلقى النموذج الاثنين؛ هذا الحقل لا يحتوي أبدًا على "
"تعليماتنا."

msgid "Applicants"
msgstr "المتقدمون"

msgid "Approaching the limit."
msgstr "تقترب من الحد."

msgid "Archive this column"
msgstr "أرشفة هذا العمود"

msgid "Archived {0}"
msgstr "تمت أرشفة {0}"

msgid "Arrange {0}"
msgstr "ترتيب {0}"

msgid ""
"Ask about anything in this workspace — the records on your screens, your "
"files, what a document says. Only what you can already open."
msgstr ""
"اسأل عن أي شيء في مساحة العمل هذه — السجلات على شاشاتك، وملفاتك، وما "
"يقوله مستند. فقط ما يمكنك فتحه أصلاً."

msgid "Ask about this workspace"
msgstr "اسأل عن مساحة العمل هذه"

msgid "Ask about {0}"
msgstr "اسأل عن {0}"

msgid "Ask something first."
msgstr "اطرح سؤالًا أولًا."

